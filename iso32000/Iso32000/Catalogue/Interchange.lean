  { ref := .clause [14, 8, 5, 7], title := "Table Attributes", status := .notImplemented,
    note := "RowSpan, ColSpan, Headers, Scope and Summary are never read; table structure in output is inferred from column gaps and rulings." },
  { ref := .clause [14, 9, 2], title := "Natural Language Specification", status := .notImplemented,
