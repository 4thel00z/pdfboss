  { ref := .clause [14, 11, 7], title := "Open Prepress Interface (OPI)", status := .outOfScope,
    note := "OPI proxy substitution is a prepress workflow pdfboss does not take part in; /OPI on image and form XObjects is ignored and the XObject itself is used." },
  { ref := .clause [14, 7, 6], title := "Example of Logical Structure", status := .outOfScope,
    note := "A worked example of a structure tree with no requirement of its own; the structure it illustrates is assessed under 14.7.2 to 14.7.5." }
]

