import Iso32000.Feature

/-!
Ledger rows for ISO 32000-1 chapter 14, Document Interchange.
-/

namespace Iso32000.Catalogue

def chapter14 : List Feature := [
  { ref := .clause [14, 2], title := "Procedure Sets", status := .notImplemented,
    note := "Nothing reads or emits /ProcSet: the reader ignores the resource (which the clause allows) and pdfboss-write never adds a /ProcSet array to the resource dictionaries it writes." },
  { ref := .clause [14, 3, 2], title := "Metadata Streams", status := .incomplete,
    note := "The writer emits an unfiltered /Type /Metadata /Subtype /XML packet on the catalog and rewrites it on update, and the reader honors EncryptMetadata false for that stream, but no reader path parses XMP (Document::metadata reads only /Info) and metadata streams on pages, XObjects or other components are neither read nor written." },
  { ref := .clause [14, 3, 3], title := "Document Information Dictionary", status := .incomplete,
    note := "Title, Author, Subject, Keywords, Creator, Producer, CreationDate and ModDate are read as decoded text strings and written back (with the XMP packet kept in step on update), but the /Trapped entry of Table 317 is neither read nor written." },
  { ref := .clause [14, 4], title := "File Identifiers", status := .implemented,
    note := "The writer emits a two-element /ID of 16-byte SHA-256-derived strings, an incremental update keeps the first half and replaces the second, the strings stay unencrypted, and the reader consumes the trailer /ID for the encryption key." },
  { ref := .clause [14, 5], title := "Page-Piece Dictionaries", status := .notImplemented,
    note := "Nothing reads or writes /PieceInfo or its /LastModified and /Private entries." },
  { ref := .clause [14, 6, 1], title := "General", status := .implemented,
    note := "MP, DP, BMC, BDC and EMC (Table 320) parse into distinct operators, and the text and render executors keep a nesting stack per content stream so EMC pops the matching open." },
  { ref := .clause [14, 6, 2], title := "Property Lists", status := .implemented,
    note := "BDC and DP operands are accepted as an inline dictionary or as a name looked up in the resource chain's /Properties subdictionary, and the named form keeps the indirect-reference identity the optional-content code keys on." },
  { ref := .clause [14, 6, 3], title := "Marked Content and Clipping", status := .incomplete,
    note := "Marked-content nesting is tracked on its own stack and EMC never touches the graphics state, so a clip set inside a sequence persists as the clause requires, but no test exercises a clipping path or q/Q pair that straddles a marked-content sequence." },
  { ref := .clause [14, 7, 2], title := "Structure Hierarchy", status := .incomplete,
    note := "The catalog's /StructTreeRoot is loaded and elements are walked through /K (single or array) and /P up to the root, but /IDTree, /ParentTreeNextKey and the element entries /T, /ID and /ActualText are never read (/S and /RoleMap are, under 14.7.3, /A, /C, /R and /ClassMap under 14.7.5, /Alt under 14.9.3, /Lang under 14.9.2 and /E under 14.9.5), and pdfboss-write neither emits a structure tree nor carries a base document's tree through assembly." },
  { ref := .clause [14, 7, 3], title := "Structure Types", status := .implemented,
    note := "crates/pdfboss-core/src/structure.rs reads each element's /S while placing a page's marked-content sequences (Walk::key_of) and the root's /RoleMap once per document (role_map_of, an indirect map resolved); StructureTree::mapped_type follows the map from a type name until a name it has no entry for, a chain in case a mapped name is itself mapped, a cycle leaving the name as written; StructureTree::place_with returns both names per sequence as Placement { rank, structure_type, mapped_type }, and ranks_with stays the rank-only view (tests structure.rs structure_types_are_read_and_mapped_through_the_role_map, an_element_without_a_type_places_with_none). Nothing yet classifies the mapped name as one of the standard types of 14.8.4." },
  { ref := .clause [14, 7, 4], title := "Structure Content", status := .incomplete,
    note := "Marked-content sequences are located as content items and resolved through the parent tree, but object references (OBJR) and the /Stm form of marked-content references are not handled; the depth-4 rows give the detail." },
  { ref := .clause [14, 7, 4, 2], title := "Marked-Content Sequences as Content Items", status := .incomplete,
    note := "Bare integer MCIDs (matched against the element's /Pg) and marked-content reference dictionaries with /Pg and /MCID are matched, and MCIDs are collected from BDC in page and form content, but the /Stm and /StmOwn entries of Table 324 are never consulted, so a form's sequence is told apart from the page's only by its /StructParents key." },
  { ref := .clause [14, 7, 4, 3], title := "PDF Objects as Content Items", status := .notImplemented,
    note := "Object reference dictionaries (/Type /OBJR with /Obj) are never read, so annotations and XObjects placed in the tree as whole objects are invisible to structure-order extraction." },
  { ref := .clause [14, 7, 4, 4], title := "Finding Structure Elements from Content Items", status := .incomplete,
    note := "The /ParentTree number tree (/Nums, /Kids, /Limits) is searched under the /StructParents key of the page or of a form XObject that declares its own, but the singular /StructParent key of whole-object content items is never used because OBJR items are not supported." },
  { ref := .clause [14, 7, 5], title := "Structure Attributes", status := .implemented,
    note := "crates/pdfboss-core/src/structure.rs Walk::attribute_objects reads every element's attribute objects while placing a page's marked-content sequences: the objects its /C classes name first, then its direct /A objects (Walk::direct_attributes: one dictionary or an array of dictionaries, indirect ones resolved), each as AttributeObject { element, owner (/O), revision, entries }; Placement::attributes lists them for the element and its ancestors, the root's child first, and Placement::attribute(element, owner, key) answers with the last object that has the key, so a direct object overrides a class's (test structure.rs placements_carry_the_elements_attribute_objects). What the standard owners' entries mean is the 14.8.5 rows' business." },
  { ref := .clause [14, 7, 5, 2], title := "Attribute Classes", status := .implemented,
    note := "StructureTree loads the root's /ClassMap once (class_map_of) and Walk::class_attributes looks up each name an element's /C gives, one name or an array, taking the class's attribute objects as if they were the element's own and putting them before the direct /A objects, so those override; a name the map lacks brings nothing (test placements_carry_the_elements_attribute_objects: /C [/Wide 4] with /A overriding the class's ColSpan)." },
  { ref := .clause [14, 7, 5, 3], title := "Attribute Revision Numbers", status := .implemented,
    note := "An element's /R lands on StructureElement::revision (0 when absent); in an /A array an integer after an attribute object is that object's revision, in a /C array an integer after a class name is the revision of every object the class brought, both on AttributeObject::revision (Walk::direct_attributes, Walk::class_attributes; test placements_carry_the_elements_attribute_objects checks /R 1, a revision 2 in /A and a revision 4 in /C). No consumer compares revisions yet." },
  { ref := .clause [14, 7, 5, 4], title := "User Properties", status := .incomplete,
    note := "A /O /UserProperties attribute object is read like any other (structure.rs attribute_object) and reaches Placement::attributes with its owner, but its /P array of property dictionaries (/N, /V, /F, /H) is not interpreted." },
  { ref := .clause [14, 8, 2], title := "Tagged PDF and Page Content", status := .incomplete,
    note := "Structure-tree reading order is offered on every extraction entry point, but artifacts, annotation sequencing, reversed show strings and ActualText are not handled; the depth-4 rows give the detail." },
  { ref := .clause [14, 8, 2, 2], title := "Real Content and Artifacts", status := .implemented,
    note := "crates/pdfboss-text/src/extract.rs marks every span shown inside an /Artifact marked-content sequence: a bare BMC gives ArtifactKind::Unspecified, a BDC's property list (inline or named through /Properties) gives the /Type of Table 330 (Pagination, Layout, Page, Background) and the /Subtype (Header, Footer, Watermark), on TextSpan::artifact (Mark::artifact, marked_artifact; test lib.rs artifact_marks_reach_the_spans); the Python Span exposes artifact and artifact_subtype. crates/pdfboss-output/src/structure.rs lays pagination artifacts out apart from the real content and gives them the PageHeader or PageFooter role by their position against the page's text midline, so Markdown drops a producer-marked running head or folio on a single page while text keeps it (attach_pagination_artifacts; test lib.rs tagged_pagination_artifacts_are_page_headers_and_footers_on_one_page); the repetition heuristic still covers untagged files. /BBox and /Attached are not read, and layout, page and background artifacts are marked but not treated differently from real content." },
  { ref := .clause [14, 8, 2, 3], title := "Page Content Order", status := .incomplete,
    note := "Under ReadingOrder::StructureTree each marked-content sequence is ranked by its depth-first position in the tree and untagged content keeps its place, but annotations are never sequenced into the order and /ReversedChars is ignored." },
  { ref := .clause [14, 8, 2, 3, 2], title := "Sequencing of Annotations", status := .notImplemented,
    note := "Annotations are not part of text extraction and OBJR items are not read, so a tagged annotation never takes its place in the reading order." },
  { ref := .clause [14, 8, 2, 3, 3], title := "Reverse-Order Show Strings", status := .implemented,
    note := "crates/pdfboss-text/src/extract.rs marks a /ReversedChars sequence (BMC or BDC, Mark::reversed) and puts every show string inside it back in logical order as it is emitted (reversed_chars): the characters reversed, a space at the beginning or end of the string kept in place; a sequence's /ActualText still wins as replacement text (test crates/pdfboss-text/src/lib.rs reversed_chars_sequences_put_their_strings_back_in_order). The span's geometry stays the visual one." },
  { ref := .clause [14, 8, 2, 4], title := "Extraction of Character Properties", status := .incomplete,
    note := "Unicode values and font style come from ToUnicode, encodings, glyph names and the FontDescriptor, but ActualText, FontFamily and FontStretch are never read; the depth-4 rows give the detail." },
  { ref := .clause [14, 8, 2, 4, 2], title := "Unicode Mapping in Tagged PDF", status := .incomplete,
    note := "Characters map through /ToUnicode first, then the /Encoding-derived table and StandardEncoding, Adobe Glyph List names, and the CIDSystemInfo ordering for CID fonts, but the /ActualText property that overrides all of these on a marked-content sequence is never read." },
  { ref := .clause [14, 8, 2, 4, 3], title := "Font Characteristics", status := .incomplete,
    note := "Weight, italic, serif and fixed-pitch come from /Flags, /FontWeight, /StemV, /ItalicAngle and the /BaseFont name, but /FontFamily and /FontStretch are never read." },
  { ref := .clause [14, 8, 2, 5], title := "Identifying Word Breaks", status := .incomplete,
    note := "Word breaks come from space glyphs and from horizontal gaps between spans, which covers the clause's positional fallback, but the tagged-PDF rules (ActualText carrying the space, breaks implied by block-level element edges) are not applied because tags are never read." },
  { ref := .clause [14, 8, 3], title := "Basic Layout Model", status := .incomplete,
    note := "Under ReadingOrder::StructureTree the page is laid out on the clause's model: crates/pdfboss-core/src/structure.rs StandardKind sorts the standard types into grouping, block-level, inline-level and illustration elements (14.8.4), crates/pdfboss-output/src/structure.rs run_of gives every span the outermost block-level element above it, and push_tagged_blocks stacks those elements as blocks in the tree's order, each block's text laid out in lines by position with its inline-level elements flowing inside (Span, Code as inline code under 14.8.4.4); a list's items and a table's rows and cells nest inside their block (tests crates/pdfboss-output/src/lib.rs tagged_block_elements_decide_the_markdown_under_structure_tree_order). The Placement and WritingMode attributes that re-class an element or turn the progression directions (14.8.5.4) are not read, so the classification comes from the standard type alone and every page is laid out left to right, top to bottom; a block-level element inside a table cell or a list body, a nested list apart, is laid out within that cell's line or item's lines rather than as a block of its own; content the tree does not reach goes through the layout heuristics." },
  { ref := .clause [14, 8, 4], title := "Standard Structure Types", status := .implemented,
    note := "crates/pdfboss-core/src/structure.rs StandardType names the 49 standard types with the standard's own spelling, StandardType::from_name recognizes a role-mapped name (case-sensitive, a document's own types staying None), StandardType::kind sorts each into the clause that defines it (StandardKind::Grouping, BlockLevel, InlineLevel, Illustration), and Placement::standard_type and Placement::path carry the result, with the standard-typed ancestry, for every placed marked-content sequence (tests structure.rs standard_types_are_recognized_by_name_and_grouped_by_clause, placements_carry_the_standard_typed_ancestry). What each set means for extraction is the depth-4 rows' business: the block-level set acts (14.8.4.3), the other three do not yet." },
  { ref := .clause [14, 8, 4, 2], title := "Grouping Elements", status := .implemented,
    note := "Under ReadingOrder::StructureTree the paragraphs inside a BlockQuote take Role::Quote (crates/pdfboss-output/src/structure.rs in_block_quote) and the Markdown adapter renders them as a block quote, every line opened with > (markdown.rs quote); a Caption or TOCI holding text with no block-level element inside is a block of its own (block_element), so a table of contents comes out one entry per block and a figure's caption never merges with its neighbour; Sect, Part and Art nesting sets the level of an H heading (14.8.4.3); Document, Div, TOC, Index, NonStruct and Private hold blocks rather than being one and leave their content as shown, Private included since its text is on the page (tests crates/pdfboss-output/src/lib.rs block_quote_paragraphs_render_as_markdown_quotes, toc_entries_are_their_own_blocks). Headings and lists inside a BlockQuote are not quoted." },
  { ref := .clause [14, 8, 4, 3], title := "Block-Level Structure Elements", status := .implemented,
    note := "Under ReadingOrder::StructureTree every span the tree reaches carries TextSpan::structure (crates/pdfboss-text/src/lib.rs Structure: the holding element's standard type and the standard-typed ancestry from Placement::path, read by crates/pdfboss-core/src/structure.rs Walk::ancestry) and crates/pdfboss-output/src/structure.rs push_tagged_blocks builds the page's blocks from it: consecutive spans of one outermost block-level element are one block, H1 to H6 a heading at that level, H a heading as deep as its Part, Art and Sect ancestors nest, L a list with an item per LI and the Lbl text as the marker (digits closed by . or ) are the number, anything else a bullet; the label stays in the item's first line and the Markdown adapter strips it by length; an item's label is its own Lbl, not a nested list's; an item without a Lbl reads its marker off its first line as an untagged page does, and a first line that is nothing but the marker stays in the layout for plain text while the Markdown adapter opens the item on the line after it), Table a table with a row per TR (THead, TBody, TFoot transparent) and a cell per TH or TD (a cell's lines joined with a space), every other block-level element a paragraph, so two P elements a line apart stay two paragraphs; spans with no block-level element go through the layout heuristics, and ruled grids are not consulted on a tagged segment (tests crates/pdfboss-output/src/lib.rs tagged_block_elements_decide_the_markdown_under_structure_tree_order, a_tagged_list_without_labels_reads_its_markers_off_the_lines, a_nested_list_keeps_its_labels_out_of_the_outer_marker, the_same_page_in_content_order_reads_by_the_layout_heuristics; crates/pdfboss-text/src/lib.rs structure_tree_order_attaches_each_span_s_standard_typed_ancestry). ListNumbering is read under 14.8.5.5 and ColSpan and RowSpan under 14.8.5.7; a nested list's content stays inside the item holding it; a label that does not open its item's first line stays in the text as a bullet item; content order, the default, still infers headings, lists and tables from layout." },
  { ref := .clause [14, 8, 4, 4], title := "Inline-Level Structure Elements", status := .incomplete,
    note := "Under ReadingOrder::StructureTree text shown inside a Code element becomes its own inline run (crates/pdfboss-output/src/structure.rs in_code, Inline::code) and the Markdown adapter sets it as a CommonMark code span, backticks one longer than any run inside and no emphasis (markdown.rs push_code; test crates/pdfboss-output/src/lib.rs code_elements_render_as_inline_code); Span, Quote, Reference, BibEntry and Annot flow into their block as shown, which is all text and Markdown have for them. Not acted on: Link keeps its text without a target (object references are unread, 14.7.4.3), Note stays in place with no footnote syntax, and Ruby and Warichu keep every part (RB, RT, RP, WT, WP) in reading order." },
  { ref := .clause [14, 8, 4, 5], title := "Illustration Elements", status := .incomplete,
    note := "Under ReadingOrder::StructureTree the text inside a Figure, Formula or Form with no block-level element inside forms an illustration run (crates/pdfboss-output/src/structure.rs Run::Illustration, run_of, push_tagged_blocks): the layout heuristics lay it out on its own, adjacent illustrations together so a table a producer drew as a row of figures is still read as a table, and none of it joins the untagged text or the tagged blocks around it; a Figure's /Alt reaches its spans (14.9.3; test crates/pdfboss-output/src/lib.rs illustration_elements_are_their_own_blocks). A figure that shows no text has no span and so no block, and no adapter renders a description in its place; image extraction works from XObjects, not from the tree." },
  { ref := .clause [14, 8, 5], title := "Standard Structure Attributes", status := .notImplemented,
    note := "Attribute objects reach Placement::attributes and TextSpan::structure with their owner and entries (14.7.5) and the standard owners are told apart (14.8.5.2); of the standard attributes themselves only the Table owner's ColSpan and RowSpan are interpreted (14.8.5.7)." },
  { ref := .clause [14, 8, 5, 2], title := "Standard Attribute Owners", status := .implemented,
    note := "crates/pdfboss-core/src/structure.rs StandardOwner names the eleven owners of Table 331 (Layout, List, PrintField, Table and the XML-1.00, HTML-3.2, HTML-4.01, OEB-1.0, RTF-1.05, CSS-1.00 and CSS-2.00 formats) with the standard's spelling; StandardOwner::from_name recognizes an /O name case-sensitively, a producer's own owner and UserProperties (14.7.5.4) staying None, and AttributeObject::standard_owner applies it, which is how the tagged table code asks for the Table owner's spans (test structure.rs standard_attribute_owners_are_recognized_by_name)." },
  { ref := .clause [14, 8, 5, 3], title := "Attribute Values and Inheritance", status := .notImplemented,
    note := "No attribute is read, so nothing is inherited down the tree." },
  { ref := .clause [14, 8, 5, 4], title := "Layout Attributes", status := .notImplemented,
    note := "Placement, WritingMode, BBox, spacing, color and column attributes are never read." },
  { ref := .clause [14, 8, 5, 5], title := "List Attribute", status := .implemented,
    note := "crates/pdfboss-output/src/structure.rs list_numbering reads a tagged list's ListNumbering from the L element's attribute objects of owner List (the last object with the key winning). When it names a numbering system (Decimal, UpperRoman, LowerRoman, UpperAlpha, LowerAlpha) push_tagged_list numbers the items: a label is read in that system (numbered_label: digits; a letter of the system's case, repeated past Z; Roman numerals of the system's case; closed by . or ) or by nothing), an unlabelled item takes the number after the previous item's, and a label outside the system (a lettered sub-item inside a Decimal list, as the 049 corpus tags them) keeps the marker its text gives (numbered_marker; tests crates/pdfboss-output/src/lib.rs list_numbering_numbers_the_items_of_a_numbered_list, structure.rs labels_are_read_in_the_list_s_numbering_system). None, Disc, Circle, Square and a missing attribute leave the markers to the labels and lines, which already read as bullets; Markdown writes every ordered item with a decimal number, and the Lang-dependent alphabet of the alphabetic systems is not consulted." },
  { ref := .clause [14, 8, 5, 6], title := "PrintField Attributes", status := .notImplemented,
    note := "Role, checked and Desc attributes of form-field elements are never read." },
  { ref := .clause [14, 8, 5, 7], title := "Table Attributes", status := .incomplete,
    note := "crates/pdfboss-output/src/structure.rs table_span reads a tagged cell's ColSpan and RowSpan from the TH or TD element's attribute objects of owner Table (TextSpan::structure carries them, the last object with the key winning, values clamped to 1..255) onto Cell::colspan and Cell::rowspan, and the Markdown adapter renders a table with either span as HTML with colspan and rowspan attributes (test crates/pdfboss-output/src/lib.rs tagged_cells_carry_their_column_and_row_spans). Headers, Scope and Summary are not read, and an untagged table's structure is still inferred from column gaps and rulings." },
  { ref := .clause [14, 9, 2], title := "Natural Language Specification", status := .implemented,
    note := "/Lang is read at all three levels: crates/pdfboss-core/src/language.rs language_with reads the catalog's as the document language (Document::language, AsyncDocument::language, Python Document.language and AsyncDocument.language), crates/pdfboss-core/src/structure.rs Walk::ancestry reads each structure element's and Placement::lang carries the nearest, and crates/pdfboss-text/src/extract.rs reads a BDC's property-list /Lang (inline or named) onto every span shown inside as TextSpan::lang, a span with none taking the nearest element's under ReadingOrder::StructureTree (Python Span.lang); every value is a text string decoded, the tag itself kept as written (tests language.rs the_catalog_lang_is_the_document_language, structure.rs placements_carry_the_nearest_language, crates/pdfboss-text/src/lib.rs natural_languages_reach_the_spans, crates/pdfboss-aio/tests/parity.rs). No output adapter uses the language yet." },
  { ref := .clause [14, 9, 2, 2], title := "Language Identifiers", status := .implemented,
    note := "crates/pdfboss-core/src/language.rs LanguageTag::parse reads a /Lang value in the RFC 3066 form the clause prescribes: a primary subtag (an ISO 639 code, or i for a registered and x for a private-use tag) and hyphen-separated subtags of one to eight ASCII letters (digits allowed after the first), the second subtag a country code when it has two letters; case carries no meaning, so the language comes out lower-case and the country upper-case, the remaining subtags as written, and an empty or overlong subtag, a character outside ASCII or a separator other than the hyphen makes the tag malformed (None). Document::language_tag applies it to the catalog's /Lang (test language.rs language_tags_split_into_language_and_country). The codes themselves are not checked against the ISO 639 and ISO 3166 lists." },
  { ref := .clause [14, 9, 2, 3], title := "Language Specification Hierarchy", status := .incomplete,
    note := "The two inner levels chain per span: a marked-content sequence's /Lang wins over the enclosing structure elements', the nearest of which wins over its ancestors' (TextSpan::lang, Placement::lang, test natural_languages_reach_the_spans); the outermost level, the catalog's /Lang, is Document::language and is not folded into a span whose sequence and elements declare none, so a caller takes it as the default itself." },
  { ref := .clause [14, 9, 2, 4], title := "Multi-language Text Arrays", status := .notImplemented,
    note := "Multi-language text arrays are not parsed." },
  { ref := .clause [14, 9, 3], title := "Alternate Descriptions", status := .implemented,
    note := "crates/pdfboss-text/src/extract.rs reads /Alt from a BDC's property list (inline or named through /Properties, decoded as a text string like /ActualText, Executor::marked_text_string) onto every span shown inside the sequence as TextSpan::alt, the shown text untouched, and under ReadingOrder::StructureTree a span with no description of its own takes the nearest structure element's /Alt, which crates/pdfboss-core/src/structure.rs Walk::ancestry reads on the way to the root and Placement::alt carries; the Python Span exposes alt (tests structure.rs placements_carry_the_nearest_alternate_description, crates/pdfboss-text/src/lib.rs alternate_descriptions_from_property_lists_reach_the_spans, alternate_descriptions_from_structure_elements_reach_the_spans). No output adapter renders a description yet, and a Figure that shows no text has no span to carry its /Alt." },
  { ref := .clause [14, 9, 4], title := "Replacement Text", status := .implemented,
    note := "crates/pdfboss-text/src/extract.rs reads /ActualText from a BDC's property list (inline or named through /Properties, any tag, decoded as a text string) and treats it as a character substitution for the sequence: the first string shown inside becomes one span carrying the replacement, every later string only widens that span's extent, and an empty replacement leaves the sequence without text (Mark::actual, ActualText, emit, marked_actual_text; tests lib.rs actual_text_replaces_the_shown_glyphs with the clause's Drucker example, actual_text_covers_the_whole_sequence_and_may_be_empty). /ActualText on a structure element dictionary is not read; the language escape sequences of 7.9.2.2 are not interpreted." },
  { ref := .clause [14, 9, 5], title := "Expansion of Abbreviations and Acronyms", status := .implemented,
    note := "crates/pdfboss-text/src/extract.rs reads /E from a BDC's property list (inline or named through /Properties, decoded as a text string like /Alt, Executor::marked_text_string) onto every span shown inside the sequence as TextSpan::expansion, the shown abbreviation untouched, and under ReadingOrder::StructureTree a span with no expansion of its own takes the nearest structure element's /E, which crates/pdfboss-core/src/structure.rs Walk::ancestry reads on the way to the root and Placement::expansion carries; the Python Span exposes expansion (tests structure.rs placements_carry_the_nearest_expansion, crates/pdfboss-text/src/lib.rs expansions_from_property_lists_reach_the_spans, expansions_from_structure_elements_reach_the_spans). No output adapter renders an expansion." },
  { ref := .clause [14, 10, 2], title := "Web Capture Information Dictionary", status := .outOfScope,
    note := "pdfboss reads, renders and writes PDFs and is not a web-capture tool, so /SpiderInfo is ignored." },
  { ref := .clause [14, 10, 3], title := "Content Database", status := .outOfScope,
    note := "Web capture is outside pdfboss's scope; the /IDS and /URLS name trees are ignored." },
  { ref := .clause [14, 10, 4], title := "Content Sets", status := .outOfScope,
    note := "Web capture is outside pdfboss's scope; /SPS and /SIS content sets are ignored." },
  { ref := .clause [14, 10, 5], title := "Source Information", status := .outOfScope,
    note := "Web capture is outside pdfboss's scope; source information dictionaries are ignored." },
  { ref := .clause [14, 10, 6], title := "Object Attributes Related to Web Capture", status := .outOfScope,
    note := "Web capture is outside pdfboss's scope; the /ID entry on page and XObject dictionaries is ignored (the trailer /ID is a different key and is handled under 14.4)." },
  { ref := .clause [14, 11, 2], title := "Page boxes", status := .implemented,
    note := "MediaBox, CropBox, BleedBox, TrimBox and ArtBox are read with the clause's defaults (crop falls back to media, the other three to crop), clipped to the media box and treated as non-inheritable, in the sync, async and Python APIs." },
  { ref := .clause [14, 11, 2, 2], title := "Display of page boxes", status := .incomplete,
    note := "Rendering maps the CropBox (turned by /Rotate) onto the output image as the clause's default visible area, but /BoxColorInfo is never read, no option renders the media, bleed, trim or art box instead, and no test renders a page whose CropBox is narrower than its MediaBox." },
  { ref := .clause [14, 11, 3], title := "Printer’s Marks", status := .notImplemented,
